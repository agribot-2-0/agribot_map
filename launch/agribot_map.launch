<?xml version="1.0"?>
<launch>

  <arg name="map_file" default="$(find agribot_map)/maps/map.yaml"/>
  <arg name="path_synchronization" default="true" />

  <include file="$(find agribot_map)/launch/map_server.launch">
    <arg name="map_file" value="$(arg map_file)"/>
  </include>

  <include if="$(arg path_synchronization)" file="$(find agribot_map)/launch/path_synchronization_node.launch"/>

  <include if="$(arg path_synchronization)" file="$(find agribot_map)/launch/task_node.launch"/>


</launch>
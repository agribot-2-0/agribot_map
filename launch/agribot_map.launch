<?xml version="1.0"?>
<launch>

  <arg name="map_file" default="$(env AGRIBOT_HOME)/agribot/configs/base/map/maps/map.yaml"/>

  <include file="$(find agribot_map)/launch/map_server.launch">
    <arg name="map_file" value="$(arg map_file)"/>
  </include>

  <include if="$(env AGRIBOT_PATH_SYNCHRONIZATION)" file="$(find agribot_map)/launch/path_synchronization_node.launch"/>

  <include if="$(env AGRIBOT_PATH_SYNCHRONIZATION)" file="$(find agribot_map)/launch/task_node.launch"/>


</launch>